digraph OLX {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.3, fontname="Helvetica", label="OLX Buy & Sell - ER diagram (crow's foot: many side at the child table)", labelloc=t, fontsize=18];
  node [shape=plain, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowtail=crow, arrowhead=tee, dir=both];
  states [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>states</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>state_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(60)</FONT></TD></TR></TABLE>>];
  cities [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>cities</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>city_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">state_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR></TABLE>>];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>user_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(120) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">phone</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(15) UQ</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">password_hash</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">city_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">is_verified</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">TIMESTAMP</FONT></TD></TR></TABLE>>];
  categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>category_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">parent_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT (self)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(80)</FONT></TD></TR></TABLE>>];
  listings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>listings</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>listing_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">seller_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">category_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">city_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">description</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">price</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">NUMERIC(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">condition</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">is_negotiable</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">TIMESTAMP</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sold_at</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">TIMESTAMP</FONT></TD></TR></TABLE>>];
  listing_images [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#334155"><TR><TD COLSPAN="3" BGCOLOR="#1e293b"><FONT COLOR="white"><B>listing_images</B></FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#b45309" POINT-SIZE="9"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>image_id</U></FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#1d4ed8" POINT-SIZE="9"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">listing_id</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">INT</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">url</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">VARCHAR(300)</FONT></TD></TR><TR><TD ALIGN="LEFT" WIDTH="30"><FONT COLOR="#999999" POINT-SIZE="9"><B>&nbsp;</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">position</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="9">SMALLINT</FONT></TD></TR></TABLE>>];
